+// advanceLastSnapshot records a snapshot as the node's newest unless the
+// node already has a newer one. A snapshot the node takes is written by a
+// goroutine of its own, and can be finished after the main loop has
+// installed a newer one that the node was sent.
+func (r *raftState) advanceLastSnapshot(index, term uint64) {
+	r.lastLock.Lock()
+	if index > r.lastSnapshotIndex {
+		r.lastSnapshotIndex = index
+		r.lastSnapshotTerm = term
+	}
+	r.lastLock.Unlock()
+}
