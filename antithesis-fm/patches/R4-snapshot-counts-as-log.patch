+// logContinuesSnapshot reports whether the log store has an entry at the
+// index of a snapshot, of the snapshot's term.
+func (r *Raft) logContinuesSnapshot(snapIdx, snapTerm uint64) bool {
+	lastLogIdx, err := r.logs.LastIndex()
+	if err != nil || lastLogIdx < snapIdx {
+		return false
+	}
+	var entry Log
+	if err := r.logs.GetLog(snapIdx, &entry); err != nil {
+		return false
+	}
+	return entry.Term == snapTerm
+}
+
+// discardLog empties the log store. The node's last entry is then the last
+// entry of its snapshot.
+func (r *Raft) discardLog() error {
+	firstIdx, err := r.logs.FirstIndex()
+	if err != nil {
+		return fmt.Errorf("failed to get first log index: %w", err)
+	}
+	lastIdx, err := r.logs.LastIndex()
+	if err != nil {
+		return fmt.Errorf("failed to get last log index: %w", err)
+	}
+	if lastIdx > 0 {
+		r.logger.Info("discarding the log", "from", firstIdx, "to", lastIdx)
+		if err := r.logs.DeleteRange(firstIdx, lastIdx); err != nil {
+			return fmt.Errorf("failed to discard the log: %w", err)
+		}
+	}
+	r.setLastLog(0, 0)
+	return nil
+}
